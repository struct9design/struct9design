# Normalizar saltos de línea — repo siempre en LF, working tree según plataforma
# Evita el ruido CRLF/LF entre colaboradores en Linux y Windows
* text=auto eol=lf

# ─── Código fuente ─────────────────────────────────────────────
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf

# ─── Estilos y markup ──────────────────────────────────────────
*.css   text eol=lf
*.scss  text eol=lf
*.sass  text eol=lf
*.html  text eol=lf
*.svg   text eol=lf

# ─── Config ────────────────────────────────────────────────────
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
.env*   text eol=lf

# ─── Docs ──────────────────────────────────────────────────────
*.md    text eol=lf
*.txt   text eol=lf

# ─── Scripts shell (Linux/Mac) — siempre LF ────────────────────
*.sh    text eol=lf

# ─── Scripts Windows — siempre CRLF ────────────────────────────
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ─── Binarios — git no los toca ────────────────────────────────
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.mp4   binary
*.mov   binary
*.webm  binary
*.node  binary
